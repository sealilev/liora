# macOS
.DS_Store
**/.DS_Store

# Personal / raw source material — not for the public repo
Present Simple/
בלוג מתנות/

# Demo videos — hosted on YouTube instead of in the repo
*.mp4
*.mov

# Clean (unwatermarked) photo originals — private, only the baked/watermarked
# copies in photography/pics/ are meant to be public
photography/originals/

# User's own working drafts (Word docs etc.) - not site content
photography/*.docx

# Staged/candidate photos not yet in the catalog ("להמשך" sheet) - private,
# ignored by the CSV->JSON pipeline too since nothing in photos.csv points here.
# User actually created it at photography/pics/queue/, not photography/queue/ -
# matching both so it's covered wherever it ends up.
photography/queue/
photography/pics/queue/
